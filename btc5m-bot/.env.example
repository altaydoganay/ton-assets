# Copy to .env and fill in ONLY if you run live mode. Keep this file private.
# .env is git-ignored. Never commit real keys.

# Polygon wallet private key that holds USDC and has Polymarket allowances set.
# Required for mode: live. Leave unset for demo.
PRIVATE_KEY=

# Optional: force mode from the environment (overrides config.yaml)
# BOT_MODE=demo
