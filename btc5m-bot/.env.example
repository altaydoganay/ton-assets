# Copy to .env and fill in ONLY if you run live mode. Keep this file private.
# .env is git-ignored. Never commit real keys.

# Polygon wallet private key. Required for mode: live. Leave unset for demo.
# This is the key that SIGNS orders.
PRIVATE_KEY=

# Only needed if your USDC sits in a Polymarket PROXY wallet (most web signups).
# Set config signature_type to 1 (email/Magic) or 2 (browser wallet) and put the
# proxy wallet address (shown as your "deposit"/account address on polymarket.com)
# here. Leave blank if your EOA holds USDC directly (signature_type: 0).
FUNDER_ADDRESS=

# Optional: force mode from the environment (overrides config.yaml)
# BOT_MODE=demo
