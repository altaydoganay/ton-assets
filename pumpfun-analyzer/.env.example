# ============================================================================
# Pump.fun Cüzdan Analizcisi — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# UYARI: Hiçbir gizli anahtarı koda gömmeyin. Bu dosya .env olarak kullanılır.
# ============================================================================

# --- Genel ---
ENVIRONMENT=development
SECRET_KEY=degistir-bu-uzun-rastgele-bir-anahtar
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# --- Veritabanı (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://pump:pump@db:5432/pumpfun
POSTGRES_USER=pump
POSTGRES_PASSWORD=pump
POSTGRES_DB=pumpfun

# --- Redis / Kuyruk ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Zincir verisi sağlayıcısı (adapter) ---
# chain_provider: "rpc" veya "helius"
CHAIN_PROVIDER=rpc
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=
HELIUS_RPC_URL=

# --- Piyasa verisi sağlayıcısı (adapter) ---
# market_provider: "dexscreener" (anahtarsız) veya "birdeye"
MARKET_PROVIDER=dexscreener
BIRDEYE_API_KEY=
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# --- Telegram bildirimleri ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- İşlem modu ---
# trading_mode: "paper" | "alerts_only" | "live"
# Canlı işlem için ayrıca LIVE_TRADING_CONFIRMED=true olmalı.
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false

# --- PumpPortal (canlı veri akışı + canlı al-sat) ---
# Veri akışı ücretsizdir (anahtarsız). İşlem (Lightning) için anahtar gerekir.
# Anahtarı https://pumpportal.fun → "Lightning Wallet / API Key" bölümünden alın
# ve o cüzdana DÜŞÜK bir bakiye yükleyin (ana cüzdanınız OLMASIN).
PUMPPORTAL_API_KEY=
PUMPPORTAL_DATA_WS=wss://pumpportal.fun/api/data
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade
PUMPPORTAL_DEFAULT_POOL=auto
# Canlı olay dinleyicisi servisi aktif mi
LIVE_LISTENER_ENABLED=true

# --- Trading cüzdanı keystore (canlı işlem) ---
# Boş bırakılırsa canlı işlem devre dışıdır. AYRI ve DÜŞÜK BAKİYELİ bir cüzdan kullanın.
KEYSTORE_PASSPHRASE=
KEYSTORE_PATH=/app/data/keystore.json

# --- Portlar (çakışma olursa değiştirin) ---
# Panelin açılacağı port. 3000 doluysa (örn. başka bir bot) 3001 yapın
# ve aşağıdaki NEXT_PUBLIC_API_URL / CORS_ORIGINS'i de buna göre güncelleyin.
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Not: PostgreSQL ve Redis yalnızca iç ağda çalışır; ana makine portu açmazlar
# (5432/6379 çakışması yaşamazsınız).

# --- Frontend ---
# Tarayıcının backend'e ulaşacağı adres (derleme anında gömülür).
# BACKEND_PORT'u değiştirirseniz buradaki portu da değiştirin.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
