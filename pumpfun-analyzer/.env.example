# ============================================================================
# Pump.fun Cüzdan Analizcisi — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# UYARI: Hiçbir gizli anahtarı koda gömmeyin. Bu dosya .env olarak kullanılır.
# ============================================================================

# --- Genel ---
ENVIRONMENT=development
SECRET_KEY=degistir-bu-uzun-rastgele-bir-anahtar
API_PREFIX=/api
# "*" = tüm kaynaklara izin (yerel kullanım için en kolayı; panel portu ne olursa
# olsun çalışır). Belirli adres(ler) istersen virgülle yaz: http://localhost:3001
CORS_ORIGINS=*

# --- Veritabanı (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://pump:pump@db:5432/pumpfun
POSTGRES_USER=pump
POSTGRES_PASSWORD=pump
POSTGRES_DB=pumpfun

# --- Redis / Kuyruk ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Zincir verisi sağlayıcısı (adapter) ---
# ÖNEMLİ: HELIUS_API_KEY tanımlıysa CHAIN_PROVIDER ne olursa olsun Helius
# Enhanced Transactions kullanılır (cüzdan başına ~100 getTransaction yerine TEK
# istek; ~10× daha AZ kredi + daha DERİN geçmiş). Yani eski .env'de "rpc" yazıyor
# olsa bile anahtar varken otomatik Helius'a geçilir (kredi tuzağı yok). Anahtar
# YOKSA standart RPC'ye düşülür.
CHAIN_PROVIDER=helius
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_WS_URL=
# RPC hız limiti koruması (429'a karşı). Helius Developer planı ~50 RPS:
# 0.04 ≈ 25 istek/sn (güvenli+hızlı). Ücretsiz katmanda 0.12 (~8 istek/sn) kullan.
RPC_MIN_INTERVAL_SECONDS=0.04
RPC_RATE_LIMIT_RETRIES=6

# --- Canlı dinleyici sağlayıcısı ---
# "helius"     → Helius WS ile keşif+takip. ÜCRETSİZ, SOL YAKMAZ. (VARSAYILAN/ÖNERİLEN)
# "pumpportal" → PumpPortal veri akışı (funded cüzdan; her olay için SOL ücreti keser!)
LISTENER_PROVIDER=helius
# Helius keşfinde dakikada en fazla işlem detayı sorgusu. Bu, keşfin ANA kredi
# kalemidir (her sorgu bir getTransaction). Bütçeye göre ayarla; planı yükselttiysen
# artırabilirsin. Büyük aday backlog'u varken düşük tutmak analiz havuzunu korur.
DISCOVERY_MAX_LOOKUPS_PER_MIN=6

# --- Piyasa verisi sağlayıcısı (adapter) ---
# market_provider: "dexscreener" (anahtarsız) veya "birdeye"
MARKET_PROVIDER=dexscreener
BIRDEYE_API_KEY=
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# --- Telegram bildirimleri ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- İşlem modu ---
# trading_mode: "paper" | "alerts_only" | "live"
# Canlı işlem için ayrıca LIVE_TRADING_CONFIRMED=true olmalı.
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false

# --- PumpPortal (yalnızca GERÇEK al-sat için) ---
# NOT: Keşif/takip artık Helius ile yapılır (üstte LISTENER_PROVIDER=helius).
# PumpPortal'a yalnızca CANLI al-sat yapacaksan ihtiyacın var. Bu anahtarın
# cüzdanı, PumpPortal veri akışında SOL ücreti keser; o yüzden veri için DEĞİL,
# sadece işlem (Lightning) için kullanıyoruz. Canlı işleme geçmeden cüzdanı
# düşük bir bakiyeyle (ayrı/küçük cüzdan) doldur. Anahtarı pumpportal.fun'dan al.
PUMPPORTAL_API_KEY=
PUMPPORTAL_DATA_WS=wss://pumpportal.fun/api/data
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade
PUMPPORTAL_DEFAULT_POOL=auto
# Canlı olay dinleyicisi servisi aktif mi
LIVE_LISTENER_ENABLED=true

# --- Otomatik cüzdan keşfi ---
# Canlı akıştan işlem yapan cüzdanları otomatik bulma. Kapatmak için false.
DISCOVERY_ENABLED=true
# Aday sayılmak için kaç farklı token alımında görülmeli. 2 = ÜCRETSİZ ön filtre:
# tek tokeni alıp kaybolan snipe/bot yerine birden çok tokende görülen (tutarlı)
# cüzdanları aday yapar; kredi yalnızca umut vadedenlere harcanır.
DISCOVERY_MIN_TOKEN_HITS=2
# Aynı anda izlenen token sayısı (yük kontrolü)
DISCOVERY_MAX_WATCHED_TOKENS=80
# Her döngüde analiz edilecek aday sayısı. Enhanced Transactions ile her cüzdan
# ~1-2 istektir; bütçen varsa artırarak backlog'u daha hızlı eritebilirsin.
DISCOVERY_BATCH_SIZE=3
# Aday analizinde taranacak işlem DERİNLİĞİ. Enhanced ile 100'er işlem tek istek;
# "8 kapalı pozisyon / 4 farklı token" kriterinin gerçek trader'larca
# karşılanabilmesi için derinlik şarttır (RPC fallback'te bunu küçült).
DISCOVERY_INGEST_LIMIT=150
# Aday analiz döngüsü aralığı (saniye)
DISCOVERY_INTERVAL_SECONDS=180

# --- Takip edilen cüzdan izleme (poll — işlem tetikleyici güvencesi) ---
# Canlı WS dinleyicisi olay KAÇIRABİLDİĞİNDEN, takip edilen cüzdanların taze
# alımları ayrıca periyodik poll ile yakalanır. UCUZ yol: getSignaturesForAddress
# (~1 kredi) + yalnızca taze/yeni imza için getTransaction (~1 kredi). Pahalı
# Enhanced KULLANILMAZ; boştaki cüzdan döngü başına ~1 kredi.
TRACKED_POLL_SECONDS=60            # poll döngü aralığı
TRACKED_POLL_PER_WALLET=6         # her cüzdandan çekilecek son imza sayısı
TRACKED_POLL_FRESH_SECONDS=900    # yalnızca son N sn içindeki alımlar işlenir (taze)

# --- Trading cüzdanı keystore (canlı işlem) ---
# Boş bırakılırsa canlı işlem devre dışıdır. AYRI ve DÜŞÜK BAKİYELİ bir cüzdan kullanın.
KEYSTORE_PASSPHRASE=
KEYSTORE_PATH=/app/data/keystore.json

# --- Portlar (çakışma olursa değiştirin) ---
# Panelin açılacağı port. 3000 doluysa (örn. başka bir bot) 3001 yapın
# ve aşağıdaki NEXT_PUBLIC_API_URL / CORS_ORIGINS'i de buna göre güncelleyin.
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Not: PostgreSQL ve Redis yalnızca iç ağda çalışır; ana makine portu açmazlar
# (5432/6379 çakışması yaşamazsınız).

# --- Frontend ---
# Tarayıcının backend'e ulaşacağı adres (derleme anında gömülür).
# BACKEND_PORT'u değiştirirseniz buradaki portu da değiştirin.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
